# Nix flake の開発環境を自動ロード
# → flake.nix の buildInputs にある mise / task / direnv が PATH に入る
# GUI から起動したシェルで Nix の標準プロファイルが PATH にない場合に補う
if ! command -v nix >/dev/null 2>&1 && [ -x /nix/var/nix/profiles/default/bin/nix ]; then
  PATH_add /nix/var/nix/profiles/default/bin
fi

use flake

# init
task init
